{
  "name": "pixbeam",
  "version": "0.1.0",
  "description": "File transfer via animated QR codes with RaptorQ fountain codes",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "test": "vitest run tests/ci/",
    "test:local": "vitest run tests/local/",
    "test:stress": "vitest run tests/stress/"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "raptorq": "^1.7.24"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "optionalDependencies": {
    "canvas": "^2.11.2",
    "sharp": "^0.33.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild",
      "sharp"
    ]
  }
}
